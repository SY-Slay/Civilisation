{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civ.invalid/schemas/religion.schema.json",
  "title": "Civilisations — religion",
  "description": "Religion fictive. Les sites saints pointent vers des provinces du monde ; aucune religion réelle n'est décrite.",
  "type": "object",
  "required": ["id", "name", "family", "tenets", "tolerance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "$ref": "common.schema.json#/$defs/localized_text" },
    "description": { "$ref": "common.schema.json#/$defs/localized_text" },
    "family": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "tenets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 },
      "uniqueItems": true
    },
    "tolerance": { "$ref": "common.schema.json#/$defs/percentage" },
    "holy_sites": {
      "$ref": "common.schema.json#/$defs/id_list"
    },
    "clergy_title": {
      "$ref": "common.schema.json#/$defs/localized_text"
    },
    "modifiers": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/modifier" }
    },
    "tags": { "$ref": "common.schema.json#/$defs/string_list" }
  }
}
